# Environment skeleton — joint ownership with C0.
# C0 owns completion of this file; C1 ships placeholders only.
# No value below is valid. Copy to .env.local and fill what you need.
# Only NEXT_PUBLIC_TURNSTILE_SITE_KEY is genuinely public.

# Postgres / Neon (C2)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL_MIGRATIONS=postgresql://user:password@host/db?sslmode=require

# Object storage for report media (C3)
BLOB_READ_WRITE_TOKEN=placeholder_blob_token

# Cloudflare Turnstile (site key is public; secret is server-only) (C2)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=placeholder_site_key
TURNSTILE_SECRET_KEY=placeholder_secret_key

# Persistent rate limiting (C2)
REPORT_RATE_LIMIT_REDIS_URL=redis://user:password@host:6379

# Background jobs (C4)
JOB_SIGNING_SECRET=placeholder_job_signing_secret

# Weather / hydrology providers (C4)
WEATHER_PROVIDER_KEY=placeholder_weather_key
GEOCODER_KEY=placeholder_geocoder_key

# Official source references (C4)
SOURCE_NOAA_URL=https://example.invalid/noaa
SOURCE_INA_URL=https://example.invalid/ina
SOURCE_SMN_URL=https://example.invalid/smn

# Public site base URL used for metadata/canonical and internal reads.
# Required when PUBLIC_ENVIRONMENT_LABEL=production.
APP_BASE_URL=http://127.0.0.1:3000

# Optional MapLibre style URL (public, embedded styles are the fallback).
# Leave empty to use the built-in offline fallback style.
NEXT_PUBLIC_MAP_STYLE_URL=

# Environment label: development | staging | production
# The fixture provider refuses to serve when this is "production".
PUBLIC_ENVIRONMENT_LABEL=development

# Error reporting (C6)
SENTRY_DSN=placeholder_sentry_dsn

# Moderation tooling (C5)
MODERATION_SIGNING_KEY=placeholder_moderation_key

# Bearer token required by POST /api/soluciones/[id]/moderate.
# Leave empty to disable the endpoint (it answers 401 for every request).
MODERATOR_TOKEN=

# JSON store backend (used when DATABASE_URL is unset). Defaults to ./data.
# PULSO_SEED_DEMO=1 seeds the demo dataset on first boot; 0 starts empty.
PULSO_DATA_DIR=
PULSO_SEED_DEMO=1
